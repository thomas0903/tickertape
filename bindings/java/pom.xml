<?xml version="1.0" encoding="UTF-8"?>
<!--
  tickertape Java binding (ADR 0037): java.lang.foreign over the C ABI in crates/tickertape-ffi. No runtime
  dependencies. Build the C library first, then run mvn verify; README.md has the commands.

  The version is the C library version this binding is written against (ADR 0037 -> Versioning); a test fails if
  it differs from crates/tickertape-ffi/include/tickertape.h, and the release tooling if it differs from the release
  tag. Nothing here publishes anything: the release workflow signs and uploads the built files to Maven Central
  (ADR 0031, docs/playbooks/release-checklist.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- io.github.<user> needs no domain: Maven Central verifies the namespace through the GitHub account (ADR 0037). -->
  <groupId>io.github.thomas0903</groupId>
  <artifactId>tickertape</artifactId>
  <version>0.5.0</version>
  <packaging>jar</packaging>

  <name>tickertape</name>
  <description>Java binding for tickertape, a crash-safe local market-data journal, over its C ABI with the Foreign Function and Memory API</description>
  <url>https://github.com/thomas0903/tickertape</url>
  <licenses>
    <license><name>MIT</name><url>https://opensource.org/licenses/MIT</url></license>
    <license><name>Apache-2.0</name><url>https://www.apache.org/licenses/LICENSE-2.0</url></license>
  </licenses>
  <!-- Maven Central requires developers and scm in every published pom. -->
  <developers>
    <developer>
      <id>thomas0903</id>
      <name>The tickertape contributors</name>
      <url>https://github.com/thomas0903/tickertape</url>
    </developer>
  </developers>
  <scm>
    <url>https://github.com/thomas0903/tickertape</url>
    <connection>scm:git:https://github.com/thomas0903/tickertape.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/thomas0903/tickertape.git</developerConnection>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/thomas0903/tickertape/issues</url>
  </issueManagement>

  <properties>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- Reproducible JAR timestamps. -->
    <project.build.outputTimestamp>2026-11-19T00:00:00Z</project.build.outputTimestamp>

    <!-- Where the built libtickertape and the test tools are (bindings/java/scripts/build-native.sh). -->
    <tickertape.native.dir>${project.basedir}/../../target/release</tickertape.native.dir>
    <tickertape.tools.dir>${tickertape.native.dir}/java-tools</tickertape.tools.dir>
    <!-- Set to true (CI does) to fail instead of skipping tests whose external tools are missing. -->
    <tickertape.test.requireTools>false</tickertape.test.requireTools>
    <tickertape.test.python>python3</tickertape.test.python>
    <!-- The test JVM's options. Tests run on the module path, patched into the binding's module, so the flag users
         need is the one tested; deny turns a restricted call without native access into an error instead of a
         warning. -->
    <tickertape.test.argLine>--enable-native-access=io.github.thomas0903.tickertape --illegal-native-access=deny --add-modules jdk.management --add-reads io.github.thomas0903.tickertape=java.management,jdk.management</tickertape.test.argLine>
    <!-- Extra options for the test JVM (for experiments; empty by default). -->
    <tickertape.test.jvmArgs></tickertape.test.jvmArgs>
    <!-- Set by the os profiles below. -->
    <tickertape.lib.file>libtickertape.so</tickertape.lib.file>
    <tickertape.platform>unknown</tickertape.platform>

    <junit.version>6.1.3</junit.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Declared (surefire would otherwise fetch it while the tests start) so that dependency:go-offline resolves it. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-clean-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-resources-plugin</artifactId><version>3.5.0</version></plugin>
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-install-plugin</artifactId><version>3.2.0</version></plugin>
        <!-- CI resolves everything up front with dependency:go-offline (see .github/workflows/ci.yml). -->
        <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-dependency-plugin</artifactId><version>3.9.0</version></plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.16.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:all</arg>
            <arg>-Xdoclint:all,-missing</arg>
            <arg>-Werror</arg>
          </compilerArgs>
        </configuration>
        <executions>
          <execution>
            <!-- The allocation test reads the thread's allocation counter (jdk.management). -->
            <id>default-testCompile</id>
            <configuration>
              <compilerArgs combine.children="append">
                <arg>--add-modules</arg>
                <arg>jdk.management</arg>
                <arg>--add-reads</arg>
                <arg>io.github.thomas0903.tickertape=java.management,jdk.management</arg>
              </compilerArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.6.1</version>
        <dependencies>
          <!-- The JUnit Platform provider, declared for the same reason as junit-platform-launcher above. -->
          <dependency>
            <groupId>org.apache.maven.surefire</groupId>
            <artifactId>surefire-junit-platform</artifactId>
            <version>3.6.1</version>
          </dependency>
        </dependencies>
        <configuration>
          <argLine>${tickertape.test.jvmArgs} ${tickertape.test.argLine}</argLine>
          <systemPropertyVariables>
            <tickertape.library.path>${tickertape.native.dir}/${tickertape.lib.file}</tickertape.library.path>
            <tickertape.test.nativeDir>${tickertape.native.dir}</tickertape.test.nativeDir>
            <tickertape.test.toolsDir>${tickertape.tools.dir}</tickertape.test.toolsDir>
            <tickertape.test.requireTools>${tickertape.test.requireTools}</tickertape.test.requireTools>
            <tickertape.test.python>${tickertape.test.python}</tickertape.test.python>
            <tickertape.test.repoRoot>${project.basedir}/../..</tickertape.test.repoRoot>
            <tickertape.test.classes>${project.build.outputDirectory}</tickertape.test.classes>
            <tickertape.test.platform>${tickertape.platform}</tickertape.test.platform>
            <tickertape.test.libFile>${tickertape.lib.file}</tickertape.test.libFile>
          </systemPropertyVariables>
          <trimStackTrace>false</trimStackTrace>
        </configuration>
        <executions>
          <!-- AllocationTest again with escape analysis off: an allocation that only the JIT removes (a wrapper object
               per call) then fails on every runner, not only where the JIT happens to compile differently. -->
          <execution>
            <id>allocation-without-escape-analysis</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <test>AllocationTest</test>
              <argLine>-XX:-DoEscapeAnalysis ${tickertape.test.jvmArgs} ${tickertape.test.argLine}</argLine>
            </configuration>
          </execution>
          <!-- PathsTest again with macOS's form-D path property (no effect elsewhere): the JDK reads it at start-up, so
               the bytes passed for an accented name, and for a listed form-C name, under it can only be tested in a JVM
               started with it. -->
          <execution>
            <id>paths-with-normalization-form-d</id>
            <goals><goal>test</goal></goals>
            <configuration>
              <test>PathsTest</test>
              <argLine>-Djdk.nio.path.useNormalizationFormD=true ${tickertape.test.jvmArgs} ${tickertape.test.argLine}</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.5.1</version>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>os-linux</id>
      <activation><os><name>Linux</name></os></activation>
      <properties><tickertape.lib.file>libtickertape.so</tickertape.lib.file></properties>
    </profile>
    <profile>
      <id>os-macos</id>
      <activation><os><family>mac</family></os></activation>
      <properties><tickertape.lib.file>libtickertape.dylib</tickertape.lib.file></properties>
    </profile>
    <profile><id>linux-x86_64</id><activation><os><name>Linux</name><arch>amd64</arch></os></activation><properties><tickertape.platform>linux-x86_64</tickertape.platform></properties></profile>
    <profile><id>linux-aarch64</id><activation><os><name>Linux</name><arch>aarch64</arch></os></activation><properties><tickertape.platform>linux-aarch64</tickertape.platform></properties></profile>
    <profile><id>macos-aarch64</id><activation><os><family>mac</family><arch>aarch64</arch></os></activation><properties><tickertape.platform>macos-aarch64</tickertape.platform></properties></profile>
    <profile><id>macos-x86_64</id><activation><os><family>mac</family><arch>x86_64</arch></os></activation><properties><tickertape.platform>macos-x86_64</tickertape.platform></properties></profile>

    <!-- The natives profile also builds tickertape-<version>-natives-<platform>.jar for each platform whose library
         scripts/stage-natives.sh has staged (library plus its SHA-256, in target/natives/<platform>), for extraction
         at run time. CI stages its own platform; the release workflow stages all four, from the C library archives,
         and publishes them to Maven Central (ADR 0031). -->
    <profile>
      <id>natives</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-jar-plugin</artifactId>
            <executions>
              <execution>
                <id>natives-linux-x86_64</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-linux-x86_64</classifier>
                  <classesDirectory>${project.build.directory}/natives/linux-x86_64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                  <archive>
                    <manifestEntries>
                      <Automatic-Module-Name>io.github.thomas0903.tickertape.natives</Automatic-Module-Name>
                    </manifestEntries>
                  </archive>
                </configuration>
              </execution>
              <execution>
                <id>natives-linux-aarch64</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-linux-aarch64</classifier>
                  <classesDirectory>${project.build.directory}/natives/linux-aarch64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                  <archive>
                    <manifestEntries>
                      <Automatic-Module-Name>io.github.thomas0903.tickertape.natives</Automatic-Module-Name>
                    </manifestEntries>
                  </archive>
                </configuration>
              </execution>
              <execution>
                <id>natives-macos-x86_64</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-macos-x86_64</classifier>
                  <classesDirectory>${project.build.directory}/natives/macos-x86_64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                  <archive>
                    <manifestEntries>
                      <Automatic-Module-Name>io.github.thomas0903.tickertape.natives</Automatic-Module-Name>
                    </manifestEntries>
                  </archive>
                </configuration>
              </execution>
              <execution>
                <id>natives-macos-aarch64</id>
                <phase>package</phase>
                <goals><goal>jar</goal></goals>
                <configuration>
                  <classifier>natives-macos-aarch64</classifier>
                  <classesDirectory>${project.build.directory}/natives/macos-aarch64</classesDirectory>
                  <skipIfEmpty>true</skipIfEmpty>
                  <archive>
                    <manifestEntries>
                      <Automatic-Module-Name>io.github.thomas0903.tickertape.natives</Automatic-Module-Name>
                    </manifestEntries>
                  </archive>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- The sources and Javadoc JARs that Maven Central requires. CI builds them with every change; the release
         workflow signs them (outside Maven, with no build code running) and uploads them. -->
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>sources</id>
                <goals><goal>jar-no-fork</goal></goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.2</version>
            <configuration>
              <doclint>all,-missing</doclint>
              <failOnWarnings>true</failOnWarnings>
              <quiet>true</quiet>
            </configuration>
            <executions>
              <execution>
                <id>javadoc</id>
                <goals><goal>jar</goal></goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
